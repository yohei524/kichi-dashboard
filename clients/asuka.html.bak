];

// ========== ロジック ==========
function getToday() { var n = new Date(); return { month: n.getMonth()+1, day: n.getDate(), year: n.getFullYear() }; }
function getJapaneseDate(m, d) {
  var ms = ['','一月','二月','三月','四月','五月','六月','七月','八月','九月','十月','十一月','十二月'];
  var ds = {1:'一',2:'二',3:'三',4:'四',5:'五',6:'六',7:'七',8:'八',9:'九',10:'十',11:'十一',12:'十二',13:'十三',14:'十四',15:'十五',16:'十六',17:'十七',18:'十八',19:'十九',20:'二十',21:'二十一',22:'二十二',23:'二十三',24:'二十四',25:'二十五',26:'二十六',27:'二十七',28:'二十八',29:'二十九',30:'三十',31:'三十一'};
  return { month: ms[m], day: ds[d] + '日' };
}
function getCurrentMonthFortune(m, d) {
  if ((m===2 && d>=4) || (m===3 && d<=4)) return monthlyFortunes[0];
  if ((m===3 && d>=5) || (m===4 && d<=4)) return monthlyFortunes[1];
  return null;
}
function getTodayFortune(m, d) {
  var key = m + '/' + d;
  for (var i = 0; i < dailyFortunes.length; i++) { if (dailyFortunes[i].date === key) return dailyFortunes[i]; }
  return null;
}
function getMonthFortunes(m) {
  var result = [];
  for (var i = 0; i < dailyFortunes.length; i++) {
    var parts = dailyFortunes[i].date.split('/');
    if (Number(parts[0]) === m) result.push(dailyFortunes[i]);
  }
  return result;
}

function buildAspectBadges(aspectStr) {
  if (!aspectStr || aspectStr === '-') return '';
  var items = aspectStr.split(' ');
  var html = '';
  for (var i = 0; i < items.length; i++) {
    var item = items[i].trim();
    if (!item) continue;
    var cls = 'badge-info';
    if (item.indexOf('天中殺') >= 0 || item.indexOf('天剋地冲') >= 0) cls = 'badge-danger';
    else if (item.indexOf('害') >= 0 || item.indexOf('刑') >= 0) cls = 'badge-warning';
    else if (item.indexOf('合') >= 0) cls = 'badge-success';
    html += '<span class="badge ' + cls + '">' + item + '</span>';
  }
  return html;
}

// カレンダーグリッド
function buildMonthGridHTML(year, month, todayM, todayD) {
  var firstDay = new Date(year, month - 1, 1).getDay();
  var startOffset = (firstDay === 0) ? 6 : firstDay - 1;
  var daysInMonth = new Date(year, month, 0).getDate();
  var html = '<div class="cal-grid">';
  var days = ['月','火','水','木','金','土','日'];
  for (var i = 0; i < 7; i++) html += '<div class="cal-header">' + days[i] + '</div>';
  for (var i = 0; i < startOffset; i++) html += '<div class="cal-cell empty"></div>';
  for (var d = 1; d <= daysInMonth; d++) {
    var key = month + '/' + d;
    var f = null;
    for (var j = 0; j < dailyFortunes.length; j++) { if (dailyFortunes[j].date === key) { f = dailyFortunes[j]; break; } }
    var isToday = (month === todayM && d === todayD);
    var cls = 'cal-cell';
    if (isToday) cls += ' today';
    if (f && f.isTenchu) cls += ' tenchu-day';
    var bg = '';
    if (f) {
      if (f.aspects.indexOf('三合') >= 0) bg = 'background:rgba(122,154,136,0.2);';
      else if (f.aspects.indexOf('天剋地冲') >= 0 || (f.isTenchu && f.aspects.indexOf('天剋地冲') >= 0)) bg = 'background:rgba(180,100,100,0.15);';
      else if (f.isTenchu) bg = 'background:rgba(180,100,100,0.08);';
      else if (f.aspects.indexOf('干合') >= 0 || f.aspects.indexOf('支合') >= 0) bg = 'background:rgba(61,110,142,0.12);';
    }
    html += '<div class="' + cls + '" style="' + bg + '" onclick="openDetail(\'' + key + '\')">';
    html += '<span class="cal-day">' + d + '</span>';
    if (f) {
      var shortAspect = '';
      if (f.aspects.indexOf('三合') >= 0) shortAspect = '🌼';
      else if (f.aspects.indexOf('天剋地冲') >= 0) shortAspect = '🌊';
      else if (f.isTenchu) shortAspect = '🌀';
      else if (f.aspects.indexOf('干合') >= 0 && f.aspects.indexOf('支合') >= 0) shortAspect = '🔗🤝';
      else if (f.aspects.indexOf('干合') >= 0) shortAspect = '🔗';
      else if (f.aspects.indexOf('支合') >= 0) shortAspect = '🤝';
      else if (f.aspects.indexOf('害') >= 0) shortAspect = '💫';
      else if (f.aspects.indexOf('刑') >= 0) shortAspect = '⚡';
      if (shortAspect) html += '<span class="cal-aspect">' + shortAspect + '</span>';
    }
    html += '</div>';
  }
  html += '</div>';
  return html;
}

var currentCalMonth = 2;
function switchMonth(m) {
  currentCalMonth = m;
  document.getElementById('month-grid-2').style.display = (m === 2) ? '' : 'none';
  document.getElementById('month-grid-3').style.display = (m === 3) ? '' : 'none';
  document.getElementById('tab-2').className = 'cal-month-tab' + (m === 2 ? ' active' : '');
  document.getElementById('tab-3').className = 'cal-month-tab' + (m === 3 ? ' active' : '');
  var mf = getMonthFortunes(m);
  var today = getToday();
  document.getElementById('detail-list-title').textContent = m + '月の日運詳細';
  document.getElementById('detail-list-body').innerHTML = buildDetailListHTML(mf, today.month, today.day);
}

// ボトムシート
function openDetail(dateKey) {
  var f = null;
  for (var i = 0; i < dailyFortunes.length; i++) { if (dailyFortunes[i].date === dateKey) { f = dailyFortunes[i]; break; } }
  if (!f) return;
  var jyuseiDesc = jyuseiDescriptions[f.jyusei] || '';
  var html = '';
  html += '<h3 style="font-size:1rem;font-weight:500;margin-bottom:0.75rem">' + f.date + '（' + f.kanshi + '）</h3>';
  html += '<div class="star-grid">';
  html += '<div class="star-box"><p class="star-label">主星</p><p class="star-value">' + f.mainStar + '</p></div>';
  html += '<div class="star-box"><p class="star-label">従星</p><p class="star-value">' + f.jyusei + '</p></div>';
  html += '</div>';
  if (f.isTenchu) html += '<div style="text-align:center;margin-bottom:0.75rem"><span class="badge badge-danger">天中殺</span></div>';
  html += '<div class="aspects" style="margin-bottom:0.75rem">' + buildAspectBadges(f.aspects) + '</div>';
  if (jyuseiDesc) { html += '<div class="detail-section"><p class="detail-label">今日のエネルギー（' + f.jyusei + '）</p><p class="detail-text">' + jyuseiDesc + '</p></div>'; }
  html += '<div class="detail-section"><p class="detail-label">主星の意味</p><p class="detail-text">' + f.starAdvice + '</p></div>';
  html += '<div class="detail-section"><p class="detail-label">位相法の解説</p><p class="detail-text">' + f.aspectNote + '</p></div>';
  html += '<div class="detail-section"><p class="detail-label">おすすめの過ごし方</p><div class="detail-recommend">' + f.recommend + '</div></div>';
  if (f.warn) html += '<div class="detail-section"><div class="detail-warn">' + f.warn + '</div></div>';
  if (f.coupleAdvice) html += '<div class="detail-section"><p class="detail-label">♡ 二人の運気合流</p><div class="couple-advice" style="margin-top:0">' + f.coupleAdvice + '</div></div>';
  document.getElementById('sheetBody').innerHTML = html;
  document.getElementById('overlay').classList.add('show');
  document.getElementById('bottomSheet').classList.add('show');
}
function closeDetail() {
  document.getElementById('overlay').classList.remove('show');
  document.getElementById('bottomSheet').classList.remove('show');
}

// 詳細リスト
function buildDetailListHTML(fortunes, todayM, todayD) {
  var html = '';
  for (var i = 0; i < fortunes.length; i++) {
    var f = fortunes[i];
    var isToday = f.date === (todayM + '/' + todayD);
    var jyuseiDesc = jyuseiDescriptions[f.jyusei] || '';
    var aspectBadges = buildAspectBadges(f.aspects);
    html += '<div class="detail-day' + (isToday ? ' highlight' : '') + '">';
    html += '<div class="detail-day-header"><div>';
    html += '<span class="detail-day-date">' + f.date + (isToday ? ' 今日' : '') + '</span> ';
    html += '<span class="detail-day-stars">' + f.mainStar + '・' + f.jyusei + '</span>';
    if (f.isTenchu) html += ' <span class="badge badge-danger" style="font-size:0.625rem;padding:0.125rem 0.5rem">天中殺</span>';
    html += '</div></div>';
    if (jyuseiDesc) { html += '<div class="detail-section"><p class="detail-label">今日のエネルギー（' + f.jyusei + '）</p><p class="detail-text">' + jyuseiDesc + '</p></div>'; }
    html += '<div class="detail-section"><p class="detail-label">主星の意味</p><p class="detail-text">' + f.starAdvice + '</p></div>';
    if (f.aspects !== '-') { html += '<div class="detail-section"><p class="detail-label">位相法</p><div class="detail-aspects">' + aspectBadges + '</div><p class="detail-text" style="margin-top:0.25rem">' + f.aspectNote + '</p></div>'; }
    if (f.isTenchu) html += '<div class="detail-section"><div class="detail-tenchu">' + f.warn + '</div></div>';
    html += '<div class="detail-section"><p class="detail-label">おすすめの過ごし方</p><div class="detail-recommend">' + f.recommend + '</div></div>';
    if (!f.isTenchu && f.warn) html += '<div class="detail-section"><div class="detail-warn">' + f.warn + '</div></div>';
    if (f.coupleAdvice) html += '<div class="detail-section"><p class="detail-label">♡ 二人の運気合流</p><div class="couple-advice" style="margin-top:0">' + f.coupleAdvice + '</div></div>';
    html += '</div>';
  }
  return html;
}

// ========== 描画 ==========
function render() {
  var today = getToday();
  var m = today.month, d = today.day;
  var jpDate = getJapaneseDate(m, d);
  var currentMonth = getCurrentMonthFortune(m, d);
  var todayFortune = getTodayFortune(m, d);
  var app = document.getElementById('app');

  // 日付
  var dateHTML = '<div class="text-center mb-4" style="padding-top:0.5rem">';
  dateHTML += '<p class="text-xs" style="color:var(--color-brown)">令和八年</p>';
  dateHTML += '<p class="date-display"><span class="date-month">' + jpDate.month + '</span><span style="margin:0 0.5rem">' + jpDate.day + '</span></p>';
  dateHTML += '</div>';

  // カレンダーグリッド
  currentCalMonth = m;
  var calHTML = '<div class="card">';
  calHTML += '<div class="card-header"><span style="color:var(--color-accent)">◇</span><span>月間カレンダー</span>';
  calHTML += '<span style="font-size:0.625rem;color:var(--color-brown);margin-left:auto">タップで詳細</span></div>';
  calHTML += '<div class="cal-month-tabs">';
  calHTML += '<div class="cal-month-tab' + (m <= 2 ? ' active' : '') + '" id="tab-2" onclick="switchMonth(2)">2月</div>';
  calHTML += '<div class="cal-month-tab' + (m >= 3 ? ' active' : '') + '" id="tab-3" onclick="switchMonth(3)">3月</div>';
  calHTML += '</div>';
  calHTML += '<div id="month-grid-2"' + (m >= 3 ? ' style="display:none"' : '') + '>' + buildMonthGridHTML(2026, 2, m, d) + '</div>';
  calHTML += '<div id="month-grid-3"' + (m <= 2 ? ' style="display:none"' : '') + '>' + buildMonthGridHTML(2026, 3, m, d) + '</div>';
  calHTML += '<div class="cal-legend">';
  calHTML += '<div class="cal-legend-item">🌼 三合</div>';
  calHTML += '<div class="cal-legend-item">🔗 干合</div>';
  calHTML += '<div class="cal-legend-item">🤝 支合</div>';
  calHTML += '<div class="cal-legend-item">🌀 天中殺</div>';
  calHTML += '<div class="cal-legend-item">🌊 天剋地冲</div>';
  calHTML += '<div class="cal-legend-item">💫 害</div>';
  calHTML += '<div class="cal-legend-item">⚡ 刑</div>';
  calHTML += '</div></div>';

  // 今日の運気
  var todayHTML = '';
  if (todayFortune) {
    var jyuseiDesc = jyuseiDescriptions[todayFortune.jyusei] || '';
    todayHTML += '<div class="today-fortune-card">';
    todayHTML += '<div class="card-header" style="border:none;padding-bottom:0.5rem"><span style="color:var(--color-accent)">◇</span><span>今日の運気</span></div>';
    todayHTML += '<div class="star-grid">';
    todayHTML += '<div class="star-box"><p class="star-label">主星</p><p class="star-value">' + todayFortune.mainStar + '</p></div>';
    todayHTML += '<div class="star-box"><p class="star-label">従星</p><p class="star-value">' + todayFortune.jyusei + '</p></div>';
    todayHTML += '<div class="star-box"><p class="star-label">干支</p><p class="star-value">' + todayFortune.kanshi + '</p></div>';
    todayHTML += '</div>';
    if (jyuseiDesc) todayHTML += '<p class="jyusei-info">' + jyuseiDesc + '</p>';
    if (todayFortune.aspects !== '-') todayHTML += '<div class="aspects">' + buildAspectBadges(todayFortune.aspects) + '</div>';
    todayHTML += '<div class="today-advice"><p style="font-size:0.625rem;color:var(--color-brown);margin-bottom:0.25rem;letter-spacing:0.1em">今日のおすすめ</p>' + todayFortune.recommend + '</div>';
    if (todayFortune.warn) todayHTML += '<div class="detail-warn" style="margin-top:0.75rem">' + todayFortune.warn + '</div>';
    if (todayFortune.coupleAdvice) {
      todayHTML += '<div class="couple-advice"><p class="couple-advice-label">♡ 二人の運気合流</p>' + todayFortune.coupleAdvice + '</div>';
    }
    todayHTML += '</div>';
  }

  // 月運
  var monthHTML = '';
  if (currentMonth) {
    monthHTML += '<div class="card">';
    monthHTML += '<div class="card-header"><span style="color:var(--color-accent)">◇</span><span>今月の流れ</span></div>';
    monthHTML += '<div class="text-center">';
    monthHTML += '<p class="text-sm mb-1"><span style="color:var(--color-brown)">' + currentMonth.period + '</span>';
    monthHTML += '<span style="margin:0 0.5rem">|</span><span>' + currentMonth.mainStar + '</span></p>';
    if (currentMonth.isTenchu) monthHTML += '<span class="badge badge-danger">月天中殺</span>';
    monthHTML += '</div>';
    monthHTML += '<p class="text-xs text-center mt-2" style="color:var(--color-brown);line-height:1.8">' + currentMonth.advice + '</p>';
    // タロット月運
    if (currentMonth.tarotCard) {
      monthHTML += '<div class="divider"></div>';
      monthHTML += '<div class="tarot-card">';
      monthHTML += '<p style="font-size:0.625rem;color:var(--color-star);letter-spacing:0.1em;margin-bottom:0.5rem">✦ タロット月運 ✦</p>';
      monthHTML += '<p class="tarot-name">' + currentMonth.tarotCard + '</p>';
      monthHTML += '<p class="tarot-meaning">' + currentMonth.tarotMeaning + '</p>';
      monthHTML += '</div>';
    }
    monthHTML += '</div>';
  }

  // 願い
  var goalHTML = '<div class="frame">';
  goalHTML += '<p class="text-xs text-center mb-3" style="color:var(--color-brown)">2026年のテーマ「17 星」</p>';
  goalHTML += '<p class="text-center text-sm font-medium" style="color:var(--color-brown-dark)">' + goal.main + '</p>';
  goalHTML += '<div class="divider"></div>';
  goalHTML += '<p class="text-xs text-center" style="color:var(--color-brown);line-height:1.8">' + goal.sub.replace(/\n/g, '<br>') + '</p>';
  goalHTML += '</div>';

  // 大切にすること / 気をつけること
  var patternHTML = '<div class="card">';
  patternHTML += '<div class="card-header"><span style="color:var(--color-accent)">◇</span><span>あすかさんの道標</span></div>';
  patternHTML += '<div class="patterns"><div>';
  patternHTML += '<p class="pattern-title win">大切にすること</p><ul class="pattern-list">';
  for (var i = 0; i < winPatterns.length; i++) patternHTML += '<li><span class="dot-win">○</span><span>' + winPatterns[i] + '</span></li>';
  patternHTML += '</ul></div><div>';
  patternHTML += '<p class="pattern-title lose">気をつけること</p><ul class="pattern-list">';
  for (var i = 0; i < losePatterns.length; i++) patternHTML += '<li><span class="dot-lose">×</span><span>' + losePatterns[i] + '</span></li>';
  patternHTML += '</ul></div></div>';
  patternHTML += '<div class="message-box" style="margin-top:1rem"><p class="text-sm" style="padding-left:1rem;line-height:1.8">「私は、彼とうまくいく方向に歩いている」</p></div>';
  patternHTML += '</div>';

  // 日運詳細リスト
  var monthFortunes = getMonthFortunes(m <= 2 ? 2 : 3);
  var detailHTML = '<div class="card">';
  detailHTML += '<div class="card-header"><span style="color:var(--color-accent)">◇</span><span id="detail-list-title">' + (m <= 2 ? 2 : 3) + '月の日運詳細</span></div>';
  detailHTML += '<div id="detail-list-body">' + buildDetailListHTML(monthFortunes, m, d) + '</div>';
  detailHTML += '</div>';

  // 宿命
  var destinyHTML = '<div class="card">';
  destinyHTML += '<div class="card-header"><span style="color:var(--color-accent)">◇</span><span>' + client.name + 'さんの宿命</span></div>';
  destinyHTML += '<div class="meishiki-item"><span class="meishiki-label">日干</span>';
  destinyHTML += '<span class="meishiki-value">' + client.dayStem + '（' + client.dayStemReading + '）= ' + client.element + '</span></div>';
  destinyHTML += '<div class="meishiki-item"><span class="meishiki-label">核の星</span>';
  destinyHTML += '<span class="meishiki-value">' + client.mainStar + '</span></div>';
  destinyHTML += '<div class="meishiki-item"><span class="meishiki-label">天中殺</span>';
  destinyHTML += '<span class="meishiki-value">' + client.tenchu + '</span></div>';
  destinyHTML += '<div class="message-box" style="margin-top:1rem"><p class="text-sm" style="padding-left:1rem;line-height:1.8">' + client.elementNote + '</p></div>';
  destinyHTML += '</div>';

  // 組み立て
  app.innerHTML = dateHTML + calHTML + todayHTML + monthHTML + goalHTML + patternHTML + detailHTML + destinyHTML;
}

render();
</script>
</body>
</html>
