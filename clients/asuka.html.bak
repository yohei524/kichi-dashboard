<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>あすかの暦</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --color-cream: #D8E4EF;          /* 藍白（あいじろ）淡色 */
  --color-warm-white: #E6EEF5;     /* 白藍（しらあい） */
  --color-beige: #B8C8D8;          /* 薄花色（うすはないろ） */
  --color-gold: #5B7E9A;           /* 縹色（はなだいろ） */
  --color-gold-light: #7A9DB8;     /* 浅縹（あさはなだ） */
  --color-brown: #3D5468;          /* 紺鼠（こんねず） */
  --color-brown-dark: #1E2E3E;     /* 鉄紺（てつこん） */
  --color-rose: #8BA0B8;           /* 薄群青 */
  --color-rose-light: #C4D4E4;     /* 白群（びゃくぐん） */
  --color-sage: #7A9A88;           /* 青竹色 */
  /* あすかさん専用の開運色（壬・水性不足を藍で補う） */
  --color-accent: #3D6E8E;         /* 紺青（こんじょう） */
  --color-accent-light: #6A9CB8;   /* 瓶覗（かめのぞき） */
  --color-accent-pale: #D0DDE8;    /* 藍白（あいじろ） */
  --color-accent-deep: #1E3A52;    /* 濃藍（こいあい） */
  --color-water: #4A8CAA;          /* 浅葱色（あさぎいろ） */
  --color-star: #B8A04A;           /* 黄金色（こがねいろ・星のカードの色） */
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Noto Serif JP', serif;
  background: linear-gradient(180deg, #A8C4D8 0%, #C4D8E8 40%, #D8E4EF 100%);
  color: var(--color-brown-dark);
  min-height: 100vh;
  line-height: 1.8;
  letter-spacing: 0.05em;
}

.container { max-width: 28rem; margin: 0 auto; padding: 0 1rem 2rem; }

header { text-align: center; padding: 2rem 1rem; }
header .sub { font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.2em; margin-bottom: 0.5rem; }
header h1 { font-size: 1.25rem; font-weight: 500; color: var(--color-brown-dark); margin-bottom: 0.25rem; }
header .tagline { font-size: 0.75rem; color: var(--color-brown); }

.card {
  background: var(--color-warm-white);
  border: 1px solid var(--color-beige);
  border-radius: 8px;
  padding: 1.25rem;
  box-shadow: 0 2px 12px rgba(30, 58, 82, 0.08);
  margin-bottom: 1.5rem;
  animation: fadeIn 0.5s ease-out;
}

.card-header {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--color-brown);
  margin-bottom: 1rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--color-beige);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--color-accent-light), transparent);
  margin: 1.5rem 0;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 0.25rem 0.75rem;
  font-size: 0.75rem;
  border-radius: 100px;
  font-weight: 400;
}
.badge-info { background: rgba(61, 110, 142, 0.15); color: var(--color-brown); border: 1px solid rgba(61, 110, 142, 0.3); }
.badge-danger { background: rgba(180, 100, 100, 0.15); color: #6B3A3A; border: 1px solid rgba(180, 100, 100, 0.3); }
.badge-warning { background: rgba(184, 160, 74, 0.2); color: #6B5A2A; border: 1px solid rgba(184, 160, 74, 0.4); }
.badge-success { background: rgba(122, 154, 136, 0.2); color: #3A5A44; border: 1px solid rgba(122, 154, 136, 0.4); }

.message-box {
  background: var(--color-cream);
  border: 1px solid var(--color-beige);
  border-radius: 4px;
  padding: 1rem 1.25rem;
  position: relative;
}
.message-box::before {
  content: '\201C';
  position: absolute;
  top: -0.25rem;
  left: 0.75rem;
  font-size: 2rem;
  color: var(--color-accent-light);
  font-family: serif;
}

.task-item {
  padding: 1rem;
  background: var(--color-cream);
  border-left: 3px solid var(--color-accent);
  margin-bottom: 0.75rem;
  border-radius: 0 4px 4px 0;
}
.task-item.priority-high { border-left-color: #B85A5A; }
.task-item.priority-normal { border-left-color: var(--color-sage); }

.task-header { display: flex; align-items: start; justify-content: space-between; margin-bottom: 0.25rem; }
.task-title { font-size: 0.875rem; font-weight: 500; }
.task-reason { font-size: 0.75rem; color: var(--color-brown); }

.star-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem; }
.star-box { text-align: center; padding: 0.75rem; background: var(--color-cream); border-radius: 4px; }
.star-label { font-size: 0.75rem; color: var(--color-brown); margin-bottom: 0.25rem; }
.star-value { font-size: 0.875rem; font-weight: 500; }

.aspects { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin-bottom: 1rem; }

.patterns { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.pattern-title { font-size: 0.75rem; text-align: center; margin-bottom: 0.75rem; }
.pattern-title.win { color: #3A5A44; }
.pattern-title.lose { color: #8B5A5A; }
.pattern-list { list-style: none; }
.pattern-list li { font-size: 0.75rem; color: var(--color-brown-dark); display: flex; align-items: start; gap: 0.5rem; margin-bottom: 0.5rem; }
.dot-win { color: var(--color-sage); margin-top: 2px; }
.dot-lose { color: #B87A7A; margin-top: 2px; }

.frame {
  position: relative;
  padding: 1.5rem;
  background: var(--color-warm-white);
  border: 1px solid var(--color-beige);
  border-radius: 4px;
  box-shadow: 0 2px 8px rgba(30, 58, 82, 0.08);
  margin-bottom: 1.5rem;
}
.frame::before {
  content: '';
  position: absolute;
  top: 8px; left: 8px; right: 8px; bottom: 8px;
  border: 1px solid var(--color-accent-light);
  border-radius: 2px;
  pointer-events: none;
}

.meishiki-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--color-beige);
}
.meishiki-item:last-child { border-bottom: none; }
.meishiki-label { font-size: 0.75rem; color: var(--color-brown); }
.meishiki-value { font-size: 0.875rem; font-weight: 500; }

.project-item {
  padding: 1rem;
  background: var(--color-cream);
  border-radius: 4px;
  margin-bottom: 0.75rem;
  border: 1px solid var(--color-beige);
}
.project-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; }
.project-name { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500; }
.status-dot { width: 8px; height: 8px; border-radius: 50%; }
.status-dot.active { background: #3A5A44; }
.status-dot.paused { background: var(--color-star); }
.project-status { font-size: 0.75rem; color: var(--color-brown); }
.project-action { font-size: 0.75rem; color: var(--color-brown-dark); background: var(--color-warm-white); padding: 0.5rem; border-radius: 4px; }
.project-action-label { font-size: 0.625rem; color: var(--color-brown); }
.project-note { font-size: 0.75rem; color: var(--color-brown); margin-top: 0.5rem; }

.text-center { text-align: center; }
.text-xs { font-size: 0.75rem; }
.text-sm { font-size: 0.875rem; }
.text-2xl { font-size: 1.5rem; }
.mb-1 { margin-bottom: 0.25rem; }
.mb-2 { margin-bottom: 0.5rem; }
.mb-3 { margin-bottom: 0.75rem; }
.mb-4 { margin-bottom: 1rem; }
.mb-6 { margin-bottom: 1.5rem; }
.mt-1 { margin-top: 0.25rem; }
.mt-2 { margin-top: 0.5rem; }
.font-medium { font-weight: 500; }
.font-light { font-weight: 300; }

.date-display { font-size: 1.5rem; font-weight: 300; color: var(--color-brown-dark); letter-spacing: 0.1em; }
.date-month { font-size: 0.875rem; color: var(--color-brown); }

footer {
  text-align: center;
  padding: 1.5rem;
  border-top: 1px solid var(--color-beige);
}
footer p { font-size: 0.75rem; color: var(--color-accent); }

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* カレンダーグリッド */
.cal-month-tabs { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
.cal-month-tab {
  flex: 1; text-align: center; padding: 0.5rem; font-size: 0.75rem;
  background: var(--color-cream); border-radius: 4px; cursor: pointer;
  color: var(--color-brown); border: 1px solid var(--color-beige);
}
.cal-month-tab.active { background: var(--color-accent); color: #fff; border-color: var(--color-accent); }

.cal-grid {
  display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; margin-bottom: 0.5rem;
}
.cal-header { text-align: center; font-size: 0.625rem; color: var(--color-brown); padding: 0.25rem 0; }
.cal-cell {
  text-align: center; padding: 0.35rem 0.1rem; font-size: 0.75rem;
  border-radius: 4px; cursor: pointer; min-height: 2.5rem;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border: 1px solid transparent; position: relative;
}
.cal-cell:hover { border-color: var(--color-accent-light); }
.cal-cell.today { border: 2px solid var(--color-accent); font-weight: 600; }
.cal-cell.empty { cursor: default; }
.cal-cell.empty:hover { border-color: transparent; }
.cal-cell .cal-day { font-size: 0.75rem; }
.cal-cell .cal-aspect { font-size: 0.5rem; margin-top: 1px; }
.cal-cell.tenchu-day { border-left: 2px solid #B85A5A; }

.cal-legend { display: flex; justify-content: center; gap: 0.75rem; font-size: 0.625rem; color: var(--color-brown); flex-wrap: wrap; }
.cal-legend-item { display: flex; align-items: center; gap: 0.25rem; }

/* 今日の運気カード */
.today-fortune-card {
  background: var(--color-warm-white);
  border: 1px solid var(--color-beige);
  border-radius: 8px;
  padding: 1.25rem;
  box-shadow: 0 2px 12px rgba(30, 58, 82, 0.08);
  margin-bottom: 1.5rem;
  animation: fadeIn 0.5s ease-out;
}
.today-advice {
  background: var(--color-cream);
  border-radius: 4px;
  padding: 0.75rem;
  font-size: 0.8rem;
  line-height: 1.6;
  margin-top: 0.75rem;
}
.jyusei-info {
  font-size: 0.75rem; color: var(--color-brown); text-align: center;
  padding: 0.5rem; background: var(--color-cream); border-radius: 4px; margin-bottom: 0.75rem;
}

/* 運気合流 */
.couple-advice {
  background: linear-gradient(135deg, rgba(61, 110, 142, 0.08), rgba(184, 160, 74, 0.08));
  border: 1px solid rgba(61, 110, 142, 0.2);
  border-radius: 4px;
  padding: 0.75rem;
  font-size: 0.8rem;
  line-height: 1.6;
  margin-top: 0.75rem;
}
.couple-advice-label {
  font-size: 0.625rem;
  color: var(--color-accent);
  letter-spacing: 0.1em;
  margin-bottom: 0.25rem;
}

/* 注意 */
.detail-warn {
  background: rgba(180, 100, 100, 0.1);
  border: 1px solid rgba(180, 100, 100, 0.2);
  border-radius: 4px;
  padding: 0.75rem;
  font-size: 0.75rem;
  color: #6B3A3A;
}

/* 日運詳細リスト */
.detail-day {
  padding: 1rem;
  border-bottom: 1px solid var(--color-beige);
  animation: fadeIn 0.3s ease-out;
}
.detail-day:last-child { border-bottom: none; }
.detail-day.highlight { background: rgba(61, 110, 142, 0.06); border-radius: 4px; }
.detail-day-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
.detail-day-date { font-size: 0.875rem; font-weight: 500; }
.detail-day-stars { font-size: 0.75rem; color: var(--color-brown); }
.detail-section { margin-bottom: 0.75rem; }
.detail-label { font-size: 0.625rem; color: var(--color-brown); letter-spacing: 0.1em; margin-bottom: 0.25rem; }
.detail-text { font-size: 0.8rem; line-height: 1.6; }
.detail-aspects { display: flex; flex-wrap: wrap; gap: 0.25rem; }
.detail-recommend {
  background: var(--color-cream); border-radius: 4px;
  padding: 0.5rem 0.75rem; font-size: 0.8rem; line-height: 1.6;
}
.detail-tenchu {
  background: rgba(180, 100, 100, 0.1); border: 1px solid rgba(180, 100, 100, 0.2);
  border-radius: 4px; padding: 0.5rem 0.75rem; font-size: 0.75rem; color: #6B3A3A;
}

/* タロット月運 */
.tarot-card {
  background: linear-gradient(135deg, var(--color-cream), rgba(184, 160, 74, 0.1));
  border: 1px solid rgba(184, 160, 74, 0.3);
  border-radius: 4px;
  padding: 1rem;
  text-align: center;
}
.tarot-name { font-size: 0.875rem; font-weight: 500; color: var(--color-brown-dark); margin-bottom: 0.25rem; }
.tarot-meaning { font-size: 0.75rem; color: var(--color-brown); line-height: 1.6; }

/* ボトムシート */
.overlay { display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(30,46,62,0.4); z-index:100; }
.overlay.show { display:block; }
.bottom-sheet {
  position:fixed; bottom:0; left:0; right:0; background:var(--color-warm-white);
  border-radius:16px 16px 0 0; max-height:75vh; overflow-y:auto; z-index:101;
  transform:translateY(100%); transition:transform 0.3s ease;
  padding:1.5rem; box-shadow:0 -4px 20px rgba(30,58,82,0.15);
}
.bottom-sheet.show { transform:translateY(0); }
.sheet-handle { width:40px; height:4px; background:var(--color-beige); border-radius:2px; margin:0 auto 1rem; }
.sheet-close { text-align:right; font-size:0.75rem; color:var(--color-brown); cursor:pointer; margin-bottom:0.5rem; }

::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: var(--color-cream); }
::-webkit-scrollbar-thumb { background: var(--color-accent-light); border-radius: 2px; }
</style>
</head>
<body>

<header>
  <p class="sub">― asuka takeuchi ―</p>
  <h1>㐂びの暦</h1>
  <p class="tagline">静かな星の光のもとで</p>
</header>
<div class="container" id="app">
  <p class="text-center text-sm" style="color:var(--color-brown);padding:2rem 0">読み込み中...</p>
</div>
<footer><p>― 傷ついたままでも、希望を持って生きていく ―</p></footer>

<!-- ボトムシート -->
<div class="overlay" id="overlay" onclick="closeDetail()"></div>
<div class="bottom-sheet" id="bottomSheet">
  <div class="sheet-handle"></div>
  <div class="sheet-close" onclick="closeDetail()">✕ 閉じる</div>
  <div id="sheetBody"></div>
</div>

<script>
// ========== クライアント情報 ==========
var client = {
  name: 'あすか',
  dayStem: '壬',
  dayStemReading: 'みずのえ',
  element: '水',
  mainStar: '鳳閣星',
  elementNote: '海や。広く深く、すべてを受け入れる器。感受性が豊かで表現力に才能がある。自然体でおること、それがあんたの本来の姿やで',
  tenchu: '子丑天中殺',
  tenchuNote: '目上運天中殺。自力で道を切り拓く力があるんや'
};

var goal = {
  main: '自分自身を取り戻す',
  sub: '2026年は「星」の年や。\n傷を癒しながら、自分の中の希望を育てるんやで。\n答えを急がんでええ。自分で選ぶ力を磨いていこな。'
};

var winPatterns = [
  '自然体でいる（鳳閣星の力）',
  '感じたことをアウトプットする',
  '迷ったら動かない',
  '心の中の言葉を選び直す'
];
var losePatterns = [
  '溜め込んで爆発する',
  '白黒つけたくて焦る（車騎×2）',
  '考えすぎて動けない→一気に動く',
  '彼の沈黙を「拒絶」と解釈する'
];

// ========== 月運 ==========
var monthlyFortunes = [
  { period:'2/4〜3/4', kanshi:'庚寅', mainStar:'龍高星', jyusei:'天胡星', aspects:'日柱：＋年柱 三合', isTenchu:false,
    advice:'三合🌼が効いてる月。追い風が吹く。新しいアイデアが湧くけど、すぐ動かんでええ。感じて、メモして、温めておく月',
    tarotCard:'女教皇', tarotMeaning:'静けさと直感のカード。動く月やなくて「感じる月」。答えは外にはない。あんたの中にある' },
  { period:'3/5〜4/4', kanshi:'辛卯', mainStar:'玉堂星', jyusei:'天極星', aspects:'日柱：支合', isTenchu:false,
    advice:'支合🤝で人との調和が取れる月。学びに向く時期。人の話をよく聴いて、吸収する',
    tarotCard:'カップの6 逆位置', tarotMeaning:'過去に囚われすぎない。思い出は消えへん。でも、あんたの足は前に向いとる' },
];

// ========== 従星辞書 ==========
var jyuseiDescriptions = {
  '天報星': 'エネルギー3。転生の星や。多芸多才で器用に立ち回れる日やで',
  '天印星': 'エネルギー6。赤ちゃんの星や。素直さ・愛嬌が武器。今日は甘え上手になれるで',
  '天貴星': 'エネルギー9。品格の星や。プライドが力になる日。堂々と振る舞ってな',
  '天恍星': 'エネルギー7。青春の星や。ロマンチックで夢見がちやけど、感性が冴える日やで',
  '天南星': 'エネルギー10。前進の星や。エネルギー満タン。攻めてOKの日やで',
  '天禄星': 'エネルギー11。壮年の星や。実力を発揮できる日。責任ある仕事に◎',
  '天将星': 'エネルギー12。王様の星や。最大エネルギー。リーダーシップ発揮。決断の日やで',
  '天堂星': 'エネルギー8。老人の星や。経験値で勝負。穏やかに過ごすのが吉やで',
  '天胡星': 'エネルギー4。霊感の星や。感性が鋭くなる日。芸術・美に触れるとええで',
  '天極星': 'エネルギー2。死の星（悪い意味やないで）。体力注意。無理せず省エネでな',
  '天庫星': 'エネルギー5。入墓の星や。片付け・整理に向く日。内省に◎やで',
  '天馳星': 'エネルギー1。あの世の星や。体力の底。スピリチュアルな感性が高まるで。早く寝てな',
};

// ========== 日運データ（2/19〜2/28） ==========
var dailyFortunes = [
  { date:'2/19', kanshi:'甲子', mainStar:'鳳閣星', jyusei:'天将星',
    aspects:'天中殺🌀 天剋地冲🌊',
    isTenchu: true,
    starAdvice: '鳳閣星はあんたの才能星や。表現力が最大になる日やけど、天中殺中やからな。アウトプットしたい衝動があっても、今日は下書きだけにしときや',
    aspectNote: '天中殺＋天剋地冲。天も地もぶつかる最強の衝突や。判断が狂いやすい日やで',
    recommend: '何も決めんでええ。衝動で連絡せんこと。日記を書いて気持ちを整理するだけでええ。天将星（12点）でエネルギーはあるけど方向が狂うからな',
    warn: '日天中殺＋天剋地冲や。今日の「こうしよう！」は全部疑ってかかってな。「彼に連絡したい」も今日はアカンで',
    coupleAdvice: '⚠最注意日やで。あすかさん天中殺＋天剋地冲、彼も天中殺＋旺刑。二人ともエネルギーが暴走しやすい日や。絶対に連絡せんこと。お互い一人で過ごす日やで' },
  { date:'2/20', kanshi:'乙丑', mainStar:'調舒星', jyusei:'天堂星',
    aspects:'天中殺🌀 庫刑⚡ 干合🔗 害💫',
    isTenchu: true,
    starAdvice: '調舒星はあんたの根底にある繊細さ・孤独の星や。一人の時間が心を整えてくれる日やで',
    aspectNote: '天中殺2日目や。庫刑で閉塞感、干合で結びつきの力はあるけど天中殺中やから空回りしやすい。害ですれ違いもあるな',
    recommend: '一人で過ごしてな。日記を書く、音楽を聴く、美しいものに触れる。感受性が研ぎ澄まされる日やで',
    warn: '天中殺中の干合は「縁があるように見えて空振り」やからな。彼から連絡が来ても冷静に。重要な返事は明日以降にしときや',
